{
	"name": "pressroom",
	"version": "0.1.0",
	"description": "多站点、逐篇、零 frontmatter 的 Obsidian 发布插件（Quartz 5 + GitHub）",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"lint": "eslint .",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"quartz",
		"publish"
	],
	"license": "MIT",
	"dependencies": {
		"@quartz-community/utils": "^1.0.1",
		"github-slugger": "^2.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "1.13.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^5.0.3",
		"yaml": "^2.9.1"
	}
}
